# Copy to backend/.env and fill in. The backend reads it on startup. Never commit .env.

# Nebius Token Factory (Nemotron models). Hackathon credits: code NEBIUS-DEVPOST-GLOBAL26 + Builders Program.
# Turn on Zero Data Retention in your Token Factory profile before processing any real email.
NEBIUS_API_KEY=
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Tavily (free tier: 1,000 credits a month)
TAVILY_API_KEY=

# Email from any provider (Gmail, Outlook / Hotmail / Microsoft 365, Yahoo, iCloud, IMAP) through Nylas v3.
#   NYLAS_API_KEY: Nylas Dashboard > API Keys.
#   NYLAS_CLIENT_ID: the Client ID on the application's overview page.
#   Register http://localhost:8000/api/connect/email/callback under Hosted authentication > Callback URIs.
# The free Sandbox allows 5 connected accounts. EU-region apps use https://api.eu.nylas.com.
NYLAS_CLIENT_ID=
NYLAS_API_KEY=
# NYLAS_API_URI=https://api.us.nylas.com
# EMAIL_REDIRECT_URI=http://localhost:8000/api/connect/email/callback
# EMAIL_MAX_MESSAGES=150
# The webhook_secret Nylas returns when you create the webhook for {PUBLIC_API_URL}/api/ingest/email/webhook
# (triggers: message.created, grant.expired, grant.deleted). Without it the webhook route answers 501.
# NYLAS_WEBHOOK_SECRET=

# Plaid, bank and card transactions. Plaid Dashboard > Developers > Keys.
# Use the Sandbox secret with PLAID_ENV=sandbox (test login: user_good / pass_good).
# PLAID_ENV=production needs Production access approved in the dashboard.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# This backend's public address. Set it once hosted: Plaid Link tokens then carry
# {PUBLIC_API_URL}/api/ingest/plaid/webhook, so new bank data arrives without pressing Sync.
# PUBLIC_API_URL=https://api.example.com

# Storage: one SQLite file. Default: backend/.local/clawback.db (git-ignored). Hosted: put it on a volume.
# CLAWBACK_DB_PATH=
# Encrypts saved tokens and stored data. Required when hosted; make one with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without it, local dev generates backend/.local/secret.key. Changing it makes saved data unreadable.
# CLAWBACK_SECRET_KEY=
# The old plaintext connections file, moved into the database (then deleted) on first start.
# CLAWBACK_CONNECTIONS_FILE=

# Sessions. visitor (default): each browser gets its own demo session, sent as the X-ClawBack-Session header.
# single: one local user "demo" with no session header, as before (handy for local development).
# CLAWBACK_SESSIONS=visitor
# CLAWBACK_SESSION_IDLE_DAYS=14
# CLAWBACK_SESSIONS_PER_IP_HOUR=20
# Daily model spend caps in USD (UTC days); 0 turns a cap off.
# CLAWBACK_SESSION_DAILY_USD=0.25
# CLAWBACK_GLOBAL_DAILY_USD=5

# The frontend's address. A comma-separated list is allowed; the first one is where email sign-in returns to.
FRONTEND_ORIGIN=http://localhost:3000
# Also allow origins matching this pattern, e.g. Vercel previews: https://clawback-[a-z0-9-]+\.vercel\.app
# FRONTEND_ORIGIN_REGEX=
CLAWBACK_AUTOSEED=1
