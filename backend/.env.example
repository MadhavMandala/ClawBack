# Copy to backend/.env and fill in. The backend reads it on startup. Never commit .env.

# Nebius Token Factory (Nemotron models). Hackathon credits: code NEBIUS-DEVPOST-GLOBAL26 + Builders Program.
# Turn on Zero Data Retention in your Token Factory profile before processing any real email.
NEBIUS_API_KEY=
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Tavily (free tier: 1,000 credits a month)
TAVILY_API_KEY=

# Email from any provider (Gmail, Outlook / Hotmail / Microsoft 365, Yahoo, iCloud, IMAP) through Nylas v3.
#   NYLAS_API_KEY: Nylas Dashboard > API Keys.
#   NYLAS_CLIENT_ID: the Client ID on the application's overview page.
#   Register http://localhost:8000/api/connect/email/callback under Hosted authentication > Callback URIs.
# The free Sandbox allows 5 connected accounts. EU-region apps use https://api.eu.nylas.com.
NYLAS_CLIENT_ID=
NYLAS_API_KEY=
# NYLAS_API_URI=https://api.us.nylas.com
# EMAIL_REDIRECT_URI=http://localhost:8000/api/connect/email/callback
# EMAIL_MAX_MESSAGES=150

# Plaid, bank and card transactions. Plaid Dashboard > Developers > Keys.
# Use the Sandbox secret with PLAID_ENV=sandbox (test login: user_good / pass_good).
# PLAID_ENV=production needs Production access approved in the dashboard.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Saved connections (Plaid token and Nylas grant id in plaintext, this machine only). Default: backend/.local/connections.json
# CLAWBACK_CONNECTIONS_FILE=

# MISSING: not used by the code yet
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

FRONTEND_ORIGIN=http://localhost:3000
CLAWBACK_AUTOSEED=1
