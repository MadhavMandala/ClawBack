{
  "manifest_version": 3,
  "name": "ClawBack for Gmail",
  "version": "0.1.0",
  "description": "Marks emails from services where ClawBack found money you can save or get back.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://*.sslip.io/*"
  ],
  "background": { "service_worker": "worker.js" },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["gmail.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost:3000/*", "https://*.vercel.app/*"],
      "js": ["handoff.js"],
      "run_at": "document_start"
    }
  ],
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "ClawBack for Gmail",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png" },
    "default_popup": "popup.html"
  }
}
