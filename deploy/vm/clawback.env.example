# Settings for the ClawBack API on the VM. setup.sh copies this file to /etc/clawback/clawback.env (readable by
# root and the clawback user only) and fills in the host name and the secret key. Fill in the rest by hand:
#   sudo nano /etc/clawback/clawback.env
#   sudo systemctl restart clawback
# One KEY=value per line. No quotes, and no comments at the end of a line.
# Never commit the filled-in copy, and never paste it into chat or a ticket.

# Nebius Token Factory (NVIDIA Nemotron models). Zero Data Retention must be on for the organization.
NEBIUS_API_KEY=

# Tavily web search.
TAVILY_API_KEY=

# Nylas (email from any provider). Register EMAIL_REDIRECT_URI under Hosted authentication > Callback URIs.
NYLAS_CLIENT_ID=
NYLAS_API_KEY=
NYLAS_API_URI=https://api.us.nylas.com
EMAIL_REDIRECT_URI=https://__HOST__/api/connect/email/callback
EMAIL_MAX_MESSAGES=150

# Plaid. The demo uses the Sandbox only.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# The Vercel production URL, with https:// and no slash at the end. CORS allows this origin, and the email
# sign-in returns the browser here.
FRONTEND_ORIGIN=https://CHANGE-ME.vercel.app

# Storage on the data disk. Back up CLAWBACK_SECRET_KEY somewhere safe: without it, saved tokens can't be
# decrypted and every visitor has to reconnect.
CLAWBACK_DB_PATH=/var/lib/clawback/clawback.db
CLAWBACK_CONNECTIONS_FILE=/var/lib/clawback/connections.json
CLAWBACK_SECRET_KEY=__SECRET__

# Seed the demo month for new visitors.
CLAWBACK_AUTOSEED=1

# After the merge: the platform work adds webhook secrets and daily model-spend caps. Copy their exact names
# from backend/.env.example once it lands, for example:
# NYLAS_WEBHOOK_SECRET=
# PLAID_WEBHOOK_URL=https://__HOST__/api/ingest/plaid/webhook
